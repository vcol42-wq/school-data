@echo off
chcp 65001 > nul
title بناء حزمة مايكروسوفت ستور v7.0.1 - The Principal
color 0b
echo ==============================================================================
echo       نظام الإدارة المدرسية الموحد - بناء حزمة متجر مايكروسوفت v7.0.1
echo ==============================================================================
echo.
echo [1/3] الانتقال لمجلد المشروع...
cd /d "%~dp0"

echo [2/3] جاري تجميع الواجهة ومحرك النظام وبناء ملف AppX v7.0.1 ...
echo يرجى الانتظار دقيقة واحدة حتى اكتمال التجميع...
echo.
call npm run dist:appx

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ==============================================================================
    echo [✓] مبروك! تم بناء الحزمة بنجاح تام 100%%
    echo الملف الجاهز للرفع إلى مايكروسوفت هو:
    echo %~dp0dist_electron\The_Principal_v7.0.1_MicrosoftStore.appx
    echo ==============================================================================
    echo.
    echo جاري فتح مجلد الحزمة تلقائياً...
    explorer "%~dp0dist_electron"
) else (
    echo.
    echo ==============================================================================
    echo [X] تنبيه: حدث خطأ أثناء البناء. يرجى مراجعة رسائل الخطأ أعلاه.
    echo ==============================================================================
)

echo.
echo اضغط أي مفتاح للإغلاق...
pause > nul
