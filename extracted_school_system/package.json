{
  "name": "react-example",
  "private": true,
  "version": "6.0.0",
  "description": "نظام الإدارة المدرسية المتكامل - الإصدار المحدث v6.0 Super Edition",
  "author": "School Management System",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --external:vite --external:electron --define:process.env.NODE_ENV=\\\"production\\\"",
    "dist": "npm run build && electron-builder --win nsis portable",
    "start": "node dist/server.js",
    "clean": "if exist dist rmdir /s /q dist && if exist dist_electron rmdir /s /q dist_electron",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.45.0",
    "@types/qrcode": "^1.5.6",
    "cors": "^2.8.6",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "electron": "34.2.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.school.management",
    "productName": "The Principal v6.0 Super Edition",
    "icon": "public/logo.png",
    "directories": {
      "output": "dist_electron"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "public/**/*",
      "build/**/*",
      "electron-main.js",
      "package.json"
    ],
    "win": {
      "icon": "public/logo.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "The Principal v6.0",
      "artifactName": "The_Principal_Setup_v6.0.exe"
    },
    "portable": {
      "artifactName": "The_Principal_Portable_v6.0.exe"
    },
    "appx": {
      "identityName": "waleedal-hasson.ThePrincipal-",
      "publisher": "CN=E9515DF7-7B48-41F8-AEE6-8C2B08D31708",
      "publisherDisplayName": "waleed al-hasson",
      "applicationId": "ThePrincipal",
      "displayName": "The Principal - الإدارة المدرسية الذكية",
      "backgroundColor": "#0F172A",
      "languages": [
        "ar",
        "en-US"
      ],
      "artifactName": "The_Principal_v6.0_MicrosoftStore.appx"
    }
  }
}
