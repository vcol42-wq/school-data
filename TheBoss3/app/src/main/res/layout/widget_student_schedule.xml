<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="12dp">

    <!-- Top Bar: Title & Day -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_day_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="جدول اليوم 📅"
            android:textColor="#FBBF24"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_student_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الثالث المتوسط (أ)"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp" />

    <!-- Today's Lessons Display -->
    <TextView
        android:id="@+id/widget_schedule_summary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="جاري تحميل حصص اليوم..."
        android:textColor="#F8FAFC"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        android:gravity="center_vertical" />

    <!-- Bottom Status / Tap to Open -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اضغط لفتح الجدول والتفاصيل ⚡"
        android:textColor="#38BDF8"
        android:textSize="10sp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

</LinearLayout>
