@echo off
chcp 65001 > nul
title بناء تطبيق أندرويد للتثبيت المباشر (APK v7.4)
color 0a
echo ==============================================================================
echo        بناء ملف أندرويد للتثبيت المباشر (APK) - إصدار 7.4 (كود 18)
echo ==============================================================================
echo.
cd /d "%~dp0"
call gradlew.bat assembleRelease

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ==============================================================================
    echo [✓] تم بناء ملف APK بنجاح!
    echo ==============================================================================
    if exist "app\build\outputs\apk\release" explorer "app\build\outputs\apk\release"
) else (
    echo.
    echo [X] تنبيه: حدث خطأ أثناء البناء.
)

pause
