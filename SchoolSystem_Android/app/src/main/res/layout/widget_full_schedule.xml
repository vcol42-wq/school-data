<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <!-- Header Bar with 5 Weekday Selector Boxes (الأحد -> الخميس) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <!-- 5 Weekday Selector Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_day_sun"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:text="الأحد"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_day_mon"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:text="الإثنين"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_day_tue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:text="الثلاثاء"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_day_wed"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:text="الأربعاء"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_day_thu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:text="الخميس"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_widget_refresh"
            android:padding="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="تحديث" />
    </LinearLayout>

    <!-- Live Decreasing Countdown Banner -->
    <TextView
        android:id="@+id/widget_countdown_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_teacher_badge_bg"
        android:padding="4dp"
        android:text="⏱️ متبقي 18m على نهاية الحصة 3"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- 6 Columns Table Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E293B"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:text="الصف / الشعبة"
            android:textColor="#38BDF8"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_lesson_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="1\n08:00"
            android:textColor="#F1F5F9"
            android:textSize="8.5sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_lesson_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="2\n08:55"
            android:textColor="#F1F5F9"
            android:textSize="8.5sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_lesson_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="3\n09:50"
            android:textColor="#F1F5F9"
            android:textSize="8.5sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_lesson_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="4\n10:45"
            android:textColor="#F1F5F9"
            android:textSize="8.5sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_lesson_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="5\n11:40"
            android:textColor="#F1F5F9"
            android:textSize="8.5sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_lesson_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="6\n12:35"
            android:textColor="#F1F5F9"
            android:textSize="8.5sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Schedule Grid List View -->
    <ListView
        android:id="@+id/widget_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#0F172A"
        android:dividerHeight="2dp"
        android:scrollbars="none" />

    <!-- Empty View when no lessons or weekend -->
    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="لا توجد دروس مسجلة اليوم ☕"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
