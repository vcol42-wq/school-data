<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/teacher_strip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="6dp"
    android:gravity="center_vertical">

    <!-- Right Header Badge & Refresh -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="4dp"
        android:paddingStart="2dp">

        <TextView
            android:id="@+id/strip_header_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الأحد"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageView
            android:id="@+id/strip_btn_refresh"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_refresh"
            android:padding="1dp"
            android:layout_marginTop="2dp"
            android:contentDescription="تحديث" />
    </LinearLayout>

    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#334155"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:contentDescription="فاصل" />

    <!-- 6 Columns for Lessons 1 to 6 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Lesson 1 Column -->
        <LinearLayout
            android:id="@+id/col_lesson_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_item_bg"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أحياء"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_class_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ثالث آ"
                android:textColor="#CBD5E1"
                android:textSize="9.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Lesson 2 Column -->
        <LinearLayout
            android:id="@+id/col_lesson_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_item_bg"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_class_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أول ب"
                android:textColor="#CBD5E1"
                android:textSize="9.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Lesson 3 Column -->
        <LinearLayout
            android:id="@+id/col_lesson_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_item_bg"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="رياضيات"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_class_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ثاني أ"
                android:textColor="#CBD5E1"
                android:textSize="9.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Lesson 4 Column -->
        <LinearLayout
            android:id="@+id/col_lesson_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_item_bg"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عربي"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_class_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="رابع ب"
                android:textColor="#CBD5E1"
                android:textSize="9.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Lesson 5 Column -->
        <LinearLayout
            android:id="@+id/col_lesson_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_item_bg"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="شاغر"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_class_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#64748B"
                android:textSize="9.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Lesson 6 Column -->
        <LinearLayout
            android:id="@+id/col_lesson_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_item_bg"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إسلامية"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_class_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="خامس أ"
                android:textColor="#CBD5E1"
                android:textSize="9.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
