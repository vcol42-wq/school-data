<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/teacher_strip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="6dp">

    <!-- Top Navigation Bar for Teacher Schedule -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Refresh Button -->
        <ImageView
            android:id="@+id/strip_btn_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_widget_refresh"
            android:padding="4dp"
            android:background="@drawable/widget_nav_btn_bg"
            android:contentDescription="تحديث" />

        <TextView
            android:id="@+id/strip_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👨‍🏫 جدول الأستاذ"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Prev Day Button -->
        <TextView
            android:id="@+id/strip_btn_prev_day"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:text="◀"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_nav_btn_bg" />

        <!-- Active Day Header Title -->
        <TextView
            android:id="@+id/strip_header_day"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="الأحد"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/widget_teacher_card_bg"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Next Day Button -->
        <TextView
            android:id="@+id/strip_btn_next_day"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:text="▶"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_nav_btn_bg" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B"
        android:layout_marginBottom="4dp" />

    <!-- 6 Columns for Lessons 1 to 6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Lesson 1 Column -->
        <LinearLayout
            android:id="@+id/col_lesson_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_item_bg"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#38BDF8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_class_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#93C5FD"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Lesson 2 Column -->
        <LinearLayout
            android:id="@+id/col_lesson_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_item_bg"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="#38BDF8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_class_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#93C5FD"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Lesson 3 Column -->
        <LinearLayout
            android:id="@+id/col_lesson_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_item_bg"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#38BDF8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_class_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#93C5FD"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Lesson 4 Column -->
        <LinearLayout
            android:id="@+id/col_lesson_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_item_bg"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="#38BDF8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_class_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#93C5FD"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Lesson 5 Column -->
        <LinearLayout
            android:id="@+id/col_lesson_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_item_bg"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="#38BDF8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_class_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#475569"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Lesson 6 Column -->
        <LinearLayout
            android:id="@+id/col_lesson_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_item_bg"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6"
                android:textColor="#38BDF8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_class_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#93C5FD"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
